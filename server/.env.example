# Existing Gemini-powered career features
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional broader internship listings from Adzuna (Himalayas remote internships are the no-key fallback)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional hosted Judge0 runner. Without a Judge0 key, Piston is used.
JUDGE0_API_KEY=
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_HOST=judge0-ce.p.rapidapi.com

# Optional HTTPS Wandbox-compatible endpoint (keyless public default)
WANDBOX_URL=https://wandbox.org/api

# Optional: improve public GitHub API rate limits
GITHUB_TOKEN=

# Optional comma-separated browser origins for non-local deployments.
# Localhost origins are allowed for development.
CORS_ORIGINS=

PORT=5001
